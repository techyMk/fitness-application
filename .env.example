# ============================================================================
# Copy to `.env` and fill in. Every value is OPTIONAL.
#
# With none of these set the app still runs completely: local-first, no
# account, no sync. That is a supported configuration, not a degraded one —
# the spec requires login to be optional (§42). These variables only turn on
# the account + multi-device layer.
# ============================================================================

# --- Neon -------------------------------------------------------------------
# Use the POOLED connection string (it has `-pooler` in the host). The HTTP
# driver opens no persistent sockets, which is what you want on serverless.
# Get it from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sessions ---------------------------------------------------------------
# REQUIRED once DATABASE_URL is set. The server refuses to boot in production
# without it rather than fall back to a guessable default.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Limits -----------------------------------------------------------------
# Per-account photo storage. Photos are downscaled to 1280px/~150 KB before
# upload, so 200 MB is roughly 1,300 photos — years of three-angle weekly shots.
# Neon's free tier is 0.5 GB total across all users.
PHOTO_QUOTA_BYTES=209715200

# --- Server -----------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Only needed if you run the API somewhere other than localhost:3001 in dev;
# the Vite proxy points at this.
# API_ORIGIN=http://localhost:3001
